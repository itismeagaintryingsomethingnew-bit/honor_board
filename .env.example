# Honor Board - local environment template.
# Copy to .env for local development:  cp .env.example .env
# NEVER commit the real .env file (it is git-ignored).

# --- Django core -----------------------------------------------------------
# Generate a proper key for anything shared:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=django-insecure-change-me-locally
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Only needed if you will open the admin from another origin.
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# --- Database --------------------------------------------------------------
# Unset (or empty) -> local SQLite (db.sqlite3), which is what you want locally.
# Uncomment and fill in to use Neon/PostgreSQL.
# Neon example (Neon console -> Dashboard -> Connection string):
# DATABASE_URL=postgresql://user:password@ep-cool-name-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# --- Student photos (optional locally) --------------------------------------
# Unset (or empty) -> store photos under media/ on your machine.
# From the Cloudinary console: Settings -> Account -> CLOUDINARY_URL
# CLOUDINARY_URL=cloudinary://123456789012345:your-api-secret@your-cloud-name
# CLOUDINARY_URL=

# --- Initial admin user (used by entrypoint.sh on SnapDeploy) --------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-please
